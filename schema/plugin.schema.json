{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plugin manifest",
  "description": "plugins/<slug>/manifest.json — everything a Companion plugin declares. The plugin's entry loads this file (Plugin.from_manifest) and only binds handlers to its kinds, so indexing and the store never run plugin code.",
  "type": "object",
  "required": ["name", "vendor", "version", "summary", "kinds"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "vendor": { "type": "string", "minLength": 1 },
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "summary": { "$ref": "common.schema.json#/$defs/summary" },
    "description": { "type": "string" },
    "symbol": { "type": "string", "description": "SF Symbol name." },
    "tint": { "$ref": "common.schema.json#/$defs/tint" },
    "category": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "contributors": { "$ref": "common.schema.json#/$defs/contributors" },
    "entry": { "type": "string", "default": "plugin.py", "pattern": "^[^/]+\\.py$" },
    "role": { "type": "string" },
    "requires": {
      "type": "array",
      "items": { "type": "string" },
      "description": "pip requirement specifiers for the plugin's own venv."
    },
    "postInstall": {
      "type": "array",
      "items": { "type": "array", "minItems": 1, "items": { "type": "string" } },
      "description": "argv lists passed to the venv python after requirements install."
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "reason": { "type": "string" },
          "required": { "type": "boolean", "default": true }
        }
      }
    },
    "meters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "unit"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "unit": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "config": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "type": { "enum": ["string", "secret", "bool", "choice"], "default": "string" },
          "default": {},
          "env": { "type": "string" },
          "choices": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" }
        }
      }
    },
    "kinds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/kind" } }
  },
  "$defs": {
    "kind": {
      "type": "object",
      "required": ["name", "description"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "inputSchema": { "type": "object" },
        "scopeSchema": { "type": "object" },
        "defaultScope": { "type": "object" },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "direction"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "direction": { "enum": ["input", "output"] },
              "description": { "type": "string" }
            }
          }
        },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "usesAct": { "type": "boolean" },
        "subTools": { "type": "array", "items": { "type": "object" } },
        "resources": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
