{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discovery action",
  "description": "discovery/<slug>/action.json — an action shown in the store that isn't a Companion plugin: an MCP server, a skill or an ACP agent. Credentials are declared, never stored; ${secret:<key>} is filled in on the installing node.",
  "type": "object",
  "required": ["type", "name", "version", "summary"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "type": { "enum": ["mcp", "skill", "acp"] },
    "name": { "type": "string", "minLength": 1 },
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "summary": { "$ref": "common.schema.json#/$defs/summary" },
    "description": { "type": "string" },
    "vendor": { "type": "string" },
    "symbol": { "type": "string" },
    "tint": { "$ref": "common.schema.json#/$defs/tint" },
    "category": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "contributors": { "$ref": "common.schema.json#/$defs/contributors" },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "url": { "type": "string", "format": "uri", "description": "Where the user gets the credential." }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [{ "required": ["stdio"] }, { "required": ["http"] }],
      "properties": {
        "stdio": {
          "type": "object",
          "required": ["arguments"],
          "additionalProperties": false,
          "properties": {
            "arguments": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "environment": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "http": {
          "type": "object",
          "required": ["url"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "headers": { "type": "object", "additionalProperties": { "type": "string" } },
            "scope": { "type": "string" }
          }
        }
      }
    },
    "skill": {
      "type": "object",
      "required": ["root"],
      "additionalProperties": false,
      "properties": {
        "root": { "type": "string", "description": "Folder in this entry holding SKILL.md." },
        "requiredNetworkHosts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "acp": {
      "type": "object",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "environment": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "mcp" } } }, "then": { "required": ["mcp"] } },
    { "if": { "properties": { "type": { "const": "skill" } } }, "then": { "required": ["skill"] } },
    { "if": { "properties": { "type": { "const": "acp" } } }, "then": { "required": ["acp"] } }
  ]
}
