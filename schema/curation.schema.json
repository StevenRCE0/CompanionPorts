{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curation",
  "description": "curation.json — how the store arranges what discovery lists. Every listed action shows regardless; this only features and groups them, by slug.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "featured": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/slug" }, "uniqueItems": true },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "items"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "items": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/slug" }, "uniqueItems": true }
        }
      }
    }
  }
}
